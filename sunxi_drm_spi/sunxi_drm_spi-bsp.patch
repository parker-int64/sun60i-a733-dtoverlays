diff --git a/bsp/drivers/drm/sunxi_drm_spi.c b/bsp/drivers/drm/sunxi_drm_spi.c
new file mode 100644
index 000000000000..701eaa6873e2
--- /dev/null
+++ b/bsp/drivers/drm/sunxi_drm_spi.c
@@ -0,0 +1,649 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Allwinner vendor DRM SPI/DBI output prototype.
+ *
+ * This driver deliberately lives in the sunxi DRM component graph.  It does
+ * not create a second DRM card or a fbdev device.  The sunxi DE remains the
+ * compositor; after the DE commit this driver copies the committed primary
+ * plane into a DMA-safe RGB565 buffer and sends it through MIPI DBI over SPI.
+ *
+ * The first version supports one primary plane and a full-frame update.  A
+ * later version should use the existing sunxi writeback connector when more
+ * than one plane is active, then send the writeback buffer over SPI.
+ */
+
+#include <linux/backlight.h>
+#include <linux/component.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/spi/spi.h>
+#include <linux/slab.h>
+#include <linux/version.h>
+
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_mipi_dbi.h>
+#include <drm/drm_of.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_print.h>
+#include <drm/drm_simple_kms_helper.h>
+
+#include <video/mipi_display.h>
+
+#include "sunxi_drm_drv.h"
+#include "sunxi_drm_crtc.h"
+
+#define SUNXI_SPI_MAX_PLANES	4
+
+struct sunxi_drm_spi {
+	struct sunxi_drm_device sdrm;
+	struct device *dev;
+	struct spi_device *spi;
+	struct device_node *spi_node;
+	struct device_node *tcon_node;
+	struct mipi_dbi dbi;
+	struct drm_display_mode mode;
+	struct regulator *power;
+	struct regulator *io;
+	struct gpio_desc *reset;
+	struct gpio_desc *dc;
+	struct backlight_device *backlight;
+	u8 *init_sequence;
+	size_t init_sequence_len;
+	u16 *tx_buf;
+	size_t tx_buf_len;
+	u32 tcon_id;
+	bool prepared;
+	struct mutex flush_lock;
+};
+
+static inline struct sunxi_drm_spi *to_sunxi_drm_spi(struct sunxi_drm_device *sdrm)
+{
+	return container_of(sdrm, struct sunxi_drm_spi, sdrm);
+}
+
+static int sunxi_spi_find_device(struct device *dev, const void *data)
+{
+	return dev->of_node == data;
+}
+
+static struct spi_device *sunxi_spi_get_by_node(struct device_node *np)
+{
+	struct device *dev;
+
+	dev = bus_find_device(&spi_bus_type, NULL, np, sunxi_spi_find_device);
+	if (!dev)
+		return NULL;
+
+	return to_spi_device(dev);
+}
+
+static int sunxi_spi_parse_mode(struct sunxi_drm_spi *spi)
+{
+	int ret;
+
+	ret = of_get_drm_panel_display_mode(spi->dev->of_node, &spi->mode, NULL);
+	if (ret) {
+		DRM_DEV_ERROR(spi->dev, "failed to parse panel-timing: %d\n", ret);
+		return ret;
+	}
+
+	spi->mode.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	if (!spi->mode.clock)
+		spi->mode.clock = spi->mode.htotal * spi->mode.vtotal * 60 / 1000;
+
+	if (!spi->mode.hdisplay || !spi->mode.vdisplay) {
+		DRM_DEV_ERROR(spi->dev, "invalid SPI panel mode\n");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int sunxi_spi_parse_init_sequence(struct sunxi_drm_spi *spi)
+{
+	int count, ret;
+
+	count = of_property_count_elems_of_size(spi->dev->of_node,
+						"init-sequence", sizeof(u8));
+	if (count <= 0) {
+		DRM_DEV_INFO(spi->dev,
+			     "no init-sequence; panel must be preconfigured or use a panel-specific sequence\n");
+		return 0;
+	}
+
+	spi->init_sequence = devm_kmalloc(spi->dev, count, GFP_KERNEL);
+	if (!spi->init_sequence)
+		return -ENOMEM;
+
+	ret = of_property_read_u8_array(spi->dev->of_node, "init-sequence",
+					spi->init_sequence, count);
+	if (ret)
+		return ret;
+
+	spi->init_sequence_len = count;
+	return 0;
+}
+
+static int sunxi_spi_regulator_get(struct sunxi_drm_spi *spi,
+					struct regulator **reg, const char *name)
+{
+	int ret;
+
+	*reg = devm_regulator_get_optional(spi->dev, name);
+	if (IS_ERR(*reg)) {
+		ret = PTR_ERR(*reg);
+		if (ret == -ENODEV) {
+			*reg = NULL;
+			dev_warn(spi->dev, "optional %s supply is absent\n", name);
+			return 0;
+		}
+		return dev_err_probe(spi->dev, ret, "failed to get %s supply\n", name);
+	}
+
+	return 0;
+}
+
+static int sunxi_spi_prepare(struct sunxi_drm_spi *spi)
+{
+	int ret;
+
+	if (spi->prepared)
+		return 0;
+
+	if (spi->power) {
+		ret = regulator_enable(spi->power);
+		if (ret)
+			return ret;
+	}
+	if (spi->io) {
+		ret = regulator_enable(spi->io);
+		if (ret)
+			goto disable_power;
+	}
+
+	if (spi->reset) {
+		gpiod_set_value_cansleep(spi->reset, 1);
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(spi->reset, 0);
+		msleep(20);
+		gpiod_set_value_cansleep(spi->reset, 1);
+		msleep(120);
+	}
+
+	spi->prepared = true;
+	DRM_DEV_INFO(spi->dev, "prepared SPI DBI panel at %u Hz\n",
+			spi->spi->max_speed_hz);
+	return 0;
+
+disable_power:
+	if (spi->power)
+		regulator_disable(spi->power);
+	return ret;
+}
+
+static void sunxi_spi_unprepare(struct sunxi_drm_spi *spi)
+{
+	if (!spi->prepared)
+		return;
+
+	if (spi->io)
+		regulator_disable(spi->io);
+	if (spi->power)
+		regulator_disable(spi->power);
+	spi->prepared = false;
+}
+
+static int sunxi_spi_execute_init_sequence(struct sunxi_drm_spi *spi)
+{
+	size_t pos = 0;
+
+	while (pos < spi->init_sequence_len) {
+		u8 command, count;
+		int ret = 0;
+
+		if (spi->init_sequence_len - pos < 2)
+			return -EINVAL;
+		command = spi->init_sequence[pos++];
+		count = spi->init_sequence[pos++];
+		if (spi->init_sequence_len - pos < count)
+			return -EINVAL;
+
+		if (command == 0 && count == 1)
+			msleep(spi->init_sequence[pos]);
+		else if (count)
+			ret = mipi_dbi_command_stackbuf(&spi->dbi, command,
+						&spi->init_sequence[pos], count);
+		else
+			ret = mipi_dbi_command(&spi->dbi, command);
+
+		if (ret) {
+			DRM_DEV_ERROR(spi->dev, "init command 0x%02x failed: %d\n",
+				      command, ret);
+			return ret;
+		}
+		pos += count;
+	}
+
+	return 0;
+}
+
+static int sunxi_spi_set_window(struct sunxi_drm_spi *spi,
+				unsigned int width, unsigned int height)
+{
+	u8 column[] = { 0, 0, (width - 1) >> 8, (width - 1) & 0xff };
+	u8 page[] = { 0, 0, (height - 1) >> 8, (height - 1) & 0xff };
+	int ret;
+
+	ret = mipi_dbi_command_buf(&spi->dbi, MIPI_DCS_SET_COLUMN_ADDRESS,
+				   column, sizeof(column));
+	if (ret)
+		return ret;
+	return mipi_dbi_command_buf(&spi->dbi, MIPI_DCS_SET_PAGE_ADDRESS,
+				    page, sizeof(page));
+}
+
+static void sunxi_spi_copy_pixel(u16 *dst, u32 pixel, u32 format)
+{
+	u8 r, g, b;
+	u16 value;
+
+	if (format == DRM_FORMAT_RGB565) {
+		value = pixel & 0xffff;
+		*dst = cpu_to_be16(value);
+		return;
+	}
+
+	r = (pixel >> 16) & 0xff;
+	g = (pixel >> 8) & 0xff;
+	b = pixel & 0xff;
+	value = ((r & 0xf8) << 8) | ((g & 0xfc) << 3) | (b >> 3);
+	*dst = cpu_to_be16(value);
+}
+
+static int sunxi_spi_copy_frame(struct sunxi_drm_spi *spi,
+				struct drm_framebuffer *fb,
+				struct iosys_map *src)
+{
+	unsigned int x, y;
+	unsigned int bpp;
+
+	if (fb->format->format != DRM_FORMAT_RGB565 &&
+	    fb->format->format != DRM_FORMAT_XRGB8888 &&
+	    fb->format->format != DRM_FORMAT_ARGB8888) {
+		DRM_DEV_ERROR_RATELIMITED(spi->dev,
+					  "unsupported framebuffer format %p4cc\n",
+					  &fb->format->format);
+		return -EINVAL;
+	}
+
+	bpp = fb->format->cpp[0];
+	for (y = 0; y < fb->height; y++) {
+		for (x = 0; x < fb->width; x++) {
+			u32 pixel;
+
+			if (bpp == 2)
+				pixel = iosys_map_rd(src, y * fb->pitches[0] + x * 2,
+							 u16);
+			else
+				pixel = iosys_map_rd(src, y * fb->pitches[0] + x * 4,
+							 u32);
+			sunxi_spi_copy_pixel(&spi->tx_buf[y * fb->width + x],
+					     pixel, fb->format->format);
+		}
+	}
+
+	return 0;
+}
+
+static struct drm_plane_state *sunxi_spi_find_primary_state(
+				struct drm_crtc_state *crtc_state)
+{
+	struct drm_plane *plane;
+	struct drm_plane_state *fallback = NULL;
+	unsigned int active_planes = 0;
+
+	drm_for_each_plane(plane, crtc_state->state->dev) {
+		struct drm_plane_state *state;
+
+		state = drm_atomic_get_new_plane_state(crtc_state->state, plane);
+		if (!state)
+			state = plane->state;
+		if (!state || state->crtc != crtc_state->crtc || !state->fb)
+			continue;
+		active_planes++;
+		if (plane->type == DRM_PLANE_TYPE_PRIMARY)
+			return state;
+		fallback = state;
+	}
+
+	if (active_planes > 1)
+		dev_warn_ratelimited(crtc_state->crtc->dev->dev,
+					 "SPI prototype only flushes one composed plane; overlays are not flattened\n");
+
+	return fallback;
+}
+
+static void sunxi_spi_atomic_flush_state(void *data,
+					 struct drm_crtc_state *crtc_state)
+{
+	struct sunxi_drm_spi *spi = data;
+	struct drm_plane_state *plane_state;
+	struct drm_framebuffer *fb;
+	struct iosys_map map[SUNXI_SPI_MAX_PLANES];
+	struct iosys_map data_map[SUNXI_SPI_MAX_PLANES];
+	int ret;
+
+	if (!crtc_state->active)
+		return;
+
+	plane_state = sunxi_spi_find_primary_state(crtc_state);
+	if (!plane_state) {
+		dev_warn_ratelimited(spi->dev,
+					 "no framebuffer in committed CRTC state\n");
+		return;
+	}
+	fb = plane_state->fb;
+	if (fb->width != spi->mode.hdisplay || fb->height != spi->mode.vdisplay ||
+	    fb->format->num_planes > SUNXI_SPI_MAX_PLANES ||
+	    (size_t)fb->width * fb->height * sizeof(u16) > spi->tx_buf_len) {
+		dev_warn_ratelimited(spi->dev,
+				     "rejecting framebuffer dimensions/planes unsuitable for SPI\n");
+		return;
+	}
+
+	mutex_lock(&spi->flush_lock);
+	ret = drm_gem_fb_begin_cpu_access(fb, DMA_FROM_DEVICE);
+	if (ret)
+		goto out_unlock;
+
+	ret = drm_gem_fb_vmap(fb, map, data_map);
+	if (ret)
+		goto out_cpu;
+
+	ret = sunxi_spi_copy_frame(spi, fb, &data_map[0]);
+	if (!ret)
+		ret = sunxi_spi_set_window(spi, fb->width, fb->height);
+	if (!ret)
+		ret = mipi_dbi_command_buf(&spi->dbi, MIPI_DCS_WRITE_MEMORY_START,
+					   (u8 *)spi->tx_buf,
+					   fb->width * fb->height * sizeof(u16));
+
+	drm_gem_fb_vunmap(fb, map);
+out_cpu:
+	drm_gem_fb_end_cpu_access(fb, DMA_FROM_DEVICE);
+out_unlock:
+	mutex_unlock(&spi->flush_lock);
+
+	if (ret)
+		DRM_DEV_ERROR_RATELIMITED(spi->dev, "frame flush failed: %d\n", ret);
+}
+
+static int sunxi_spi_encoder_atomic_check(struct drm_encoder *encoder,
+						struct drm_crtc_state *crtc_state,
+						struct drm_connector_state *conn_state)
+{
+	struct sunxi_drm_device *sdrm = container_of(encoder,
+							struct sunxi_drm_device, encoder);
+	struct sunxi_drm_spi *spi = to_sunxi_drm_spi(sdrm);
+	struct sunxi_crtc_state *scrtc_state = to_sunxi_crtc_state(crtc_state);
+
+	scrtc_state->tcon_id = spi->tcon_id;
+	scrtc_state->output_dev_data = spi;
+	scrtc_state->atomic_flush = NULL;
+	scrtc_state->atomic_flush_state = sunxi_spi_atomic_flush_state;
+	return 0;
+}
+
+static void sunxi_spi_encoder_atomic_enable(struct drm_encoder *encoder,
+						struct drm_atomic_state *state)
+{
+	struct sunxi_drm_device *sdrm = container_of(encoder,
+							struct sunxi_drm_device, encoder);
+	struct sunxi_drm_spi *spi = to_sunxi_drm_spi(sdrm);
+	int ret;
+
+	ret = sunxi_spi_prepare(spi);
+	if (ret) {
+		DRM_DEV_ERROR(spi->dev, "panel prepare failed: %d\n", ret);
+		return;
+	}
+	ret = sunxi_spi_execute_init_sequence(spi);
+	if (ret)
+		DRM_DEV_ERROR(spi->dev, "panel init sequence failed: %d\n", ret);
+	if (spi->backlight)
+		backlight_enable(spi->backlight);
+}
+
+static void sunxi_spi_encoder_atomic_disable(struct drm_encoder *encoder,
+						 struct drm_atomic_state *state)
+{
+	struct sunxi_drm_device *sdrm = container_of(encoder,
+							struct sunxi_drm_device, encoder);
+	struct sunxi_drm_spi *spi = to_sunxi_drm_spi(sdrm);
+
+	if (spi->backlight)
+		backlight_disable(spi->backlight);
+	mipi_dbi_command(&spi->dbi, MIPI_DCS_SET_DISPLAY_OFF);
+	mipi_dbi_command(&spi->dbi, MIPI_DCS_ENTER_SLEEP_MODE);
+	sunxi_spi_unprepare(spi);
+}
+
+static const struct drm_encoder_helper_funcs sunxi_spi_encoder_helper_funcs = {
+	.atomic_check = sunxi_spi_encoder_atomic_check,
+	.atomic_enable = sunxi_spi_encoder_atomic_enable,
+	.atomic_disable = sunxi_spi_encoder_atomic_disable,
+};
+
+static enum drm_connector_status sunxi_spi_detect(struct drm_connector *connector,
+						bool force)
+{
+	return connector_status_connected;
+}
+
+static int sunxi_spi_get_modes(struct drm_connector *connector)
+{
+	struct sunxi_drm_device *sdrm = container_of(connector,
+							struct sunxi_drm_device, connector);
+	struct sunxi_drm_spi *spi = to_sunxi_drm_spi(sdrm);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &spi->mode);
+	if (!mode)
+		return 0;
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+static const struct drm_connector_helper_funcs sunxi_spi_connector_helper_funcs = {
+	.get_modes = sunxi_spi_get_modes,
+};
+
+static const struct drm_connector_funcs sunxi_spi_connector_funcs = {
+	.detect = sunxi_spi_detect,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.reset = drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+static int sunxi_spi_bind(struct device *dev, struct device *master, void *data)
+{
+	struct sunxi_drm_spi *spi = dev_get_drvdata(dev);
+	struct drm_device *drm = data;
+	int ret;
+
+	spi->sdrm.drm_dev = drm;
+	drm_encoder_helper_add(&spi->sdrm.encoder,
+				      &sunxi_spi_encoder_helper_funcs);
+	ret = drm_simple_encoder_init(drm, &spi->sdrm.encoder,
+				      DRM_MODE_ENCODER_NONE);
+	if (ret)
+		return ret;
+
+	if (spi->tcon_node)
+		spi->sdrm.encoder.possible_crtcs =
+			drm_of_find_possible_crtcs(drm, spi->tcon_node);
+	else
+		spi->sdrm.encoder.possible_crtcs = ~0u;
+
+	drm_connector_helper_add(&spi->sdrm.connector,
+				 &sunxi_spi_connector_helper_funcs);
+	ret = drm_connector_init(drm, &spi->sdrm.connector,
+				 &sunxi_spi_connector_funcs, DRM_MODE_CONNECTOR_SPI);
+	if (ret) {
+		drm_encoder_cleanup(&spi->sdrm.encoder);
+		return ret;
+	}
+
+	spi->sdrm.connector.polled = 0;
+	drm_connector_attach_encoder(&spi->sdrm.connector, &spi->sdrm.encoder);
+	DRM_DEV_INFO(dev, "bound to sunxi DRM master: %ux%u@%uHz\n",
+			spi->mode.hdisplay, spi->mode.vdisplay,
+			drm_mode_vrefresh(&spi->mode));
+	return 0;
+}
+
+static void sunxi_spi_unbind(struct device *dev, struct device *master,
+				     void *data)
+{
+	struct sunxi_drm_spi *spi = dev_get_drvdata(dev);
+
+	drm_connector_cleanup(&spi->sdrm.connector);
+	drm_encoder_cleanup(&spi->sdrm.encoder);
+}
+
+static const struct component_ops sunxi_spi_component_ops = {
+	.bind = sunxi_spi_bind,
+	.unbind = sunxi_spi_unbind,
+};
+
+static int sunxi_spi_probe(struct platform_device *pdev)
+{
+	struct sunxi_drm_spi *spi;
+	struct device_node *np = pdev->dev.of_node;
+	struct device_node *tcon;
+	int ret;
+
+	spi = devm_kzalloc(&pdev->dev, sizeof(*spi), GFP_KERNEL);
+	if (!spi)
+		return -ENOMEM;
+	spi->dev = &pdev->dev;
+	mutex_init(&spi->flush_lock);
+	spi->sdrm.hw_id = 0;
+
+	spi->spi_node = of_parse_phandle(np, "spi", 0);
+	if (!spi->spi_node)
+		return dev_err_probe(&pdev->dev, -EINVAL, "missing spi phandle\n");
+	spi->spi = sunxi_spi_get_by_node(spi->spi_node);
+	if (!spi->spi) {
+		ret = dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				    "SPI device is not ready\n");
+		of_node_put(spi->spi_node);
+		return ret;
+	}
+
+	tcon = of_parse_phandle(np, "tcon", 0);
+	spi->tcon_node = tcon;
+	if (of_property_read_u32(np, "tcon-id", &spi->tcon_id))
+		spi->tcon_id = 0;
+
+	ret = sunxi_spi_parse_mode(spi);
+	if (ret)
+		goto put_spi;
+	ret = sunxi_spi_parse_init_sequence(spi);
+	if (ret)
+		goto put_spi;
+	ret = sunxi_spi_regulator_get(spi, &spi->power, "power");
+	if (ret)
+		goto put_spi;
+	ret = sunxi_spi_regulator_get(spi, &spi->io, "io");
+	if (ret)
+		goto put_spi;
+
+	spi->reset = devm_gpiod_get_optional(&pdev->dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(spi->reset)) {
+		ret = PTR_ERR(spi->reset);
+		goto put_spi;
+	}
+	spi->dc = devm_gpiod_get_optional(&pdev->dev, "dc", GPIOD_OUT_LOW);
+	if (IS_ERR(spi->dc)) {
+		ret = PTR_ERR(spi->dc);
+		goto put_spi;
+	}
+	spi->backlight = devm_of_find_backlight(&pdev->dev);
+	if (IS_ERR(spi->backlight)) {
+		ret = PTR_ERR(spi->backlight);
+		goto put_spi;
+	}
+
+	ret = mipi_dbi_spi_init(spi->spi, &spi->dbi, spi->dc);
+	if (ret)
+		goto put_spi;
+	spi->dbi.reset = spi->reset;
+	spi->tx_buf_len = spi->mode.hdisplay * spi->mode.vdisplay * sizeof(u16);
+	spi->tx_buf = devm_kmalloc(&pdev->dev, spi->tx_buf_len, GFP_KERNEL);
+	if (!spi->tx_buf) {
+		ret = -ENOMEM;
+		goto put_spi;
+	}
+
+	platform_set_drvdata(pdev, spi);
+	DRM_DEV_INFO(&pdev->dev,
+		     "probed SPI DBI output (%ux%u, %u Hz); SPI DMA is controller-dependent\n",
+		     spi->mode.hdisplay, spi->mode.vdisplay, spi->spi->max_speed_hz);
+	ret = component_add(&pdev->dev, &sunxi_spi_component_ops);
+	if (ret)
+		goto put_spi;
+	return 0;
+
+put_spi:
+	of_node_put(spi->tcon_node);
+	of_node_put(spi->spi_node);
+	put_device(&spi->spi->dev);
+	return ret;
+}
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 11, 0)
+static int sunxi_spi_remove(struct platform_device *pdev)
+#else
+static void sunxi_spi_remove(struct platform_device *pdev)
+#endif
+{
+	struct sunxi_drm_spi *spi = platform_get_drvdata(pdev);
+
+	component_del(&pdev->dev, &sunxi_spi_component_ops);
+	if (spi) {
+		of_node_put(spi->tcon_node);
+		of_node_put(spi->spi_node);
+	}
+	if (spi && spi->spi)
+		put_device(&spi->spi->dev);
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 11, 0)
+	return 0;
+#endif
+}
+
+static const struct of_device_id sunxi_spi_match[] = {
+	{ .compatible = "allwinner,sunxi-drm-spi" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sunxi_spi_match);
+
+struct platform_driver sunxi_spi_platform_driver = {
+	.probe = sunxi_spi_probe,
+	.remove = sunxi_spi_remove,
+	.driver = {
+		.name = "sunxi-drm-spi",
+		.of_match_table = sunxi_spi_match,
+	},
+};
+
+MODULE_DESCRIPTION("Allwinner sunxi DRM SPI/DBI output");
+MODULE_LICENSE("GPL");
